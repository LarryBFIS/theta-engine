# Tastytrade OAuth2 credentials
# Get these from https://my.tastytrade.com → My Profile → API → OAuth Applications
TASTYTRADE_CLIENT_SECRET=your-oauth-client-secret-here
TASTYTRADE_REFRESH_TOKEN=your-oauth-refresh-token-here

# Pushover
PUSHOVER_USER_KEY=your-30-char-pushover-user-key
PUSHOVER_APP_TOKEN=your-pushover-app-token

# Experiment baseline
STARTING_CAPITAL=3389.91

# Optional: log level
LOG_LEVEL=INFO
